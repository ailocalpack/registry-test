{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ailocalpack.github.io/registry/schemas/registry-index.schema.json",
  "title": "ailocalpack registry index",
  "description": "index.json published to GitHub Pages: every pack of the registry, by game and language, with the community numbers aggregated by the registry's Actions. Built by `ailocalpack index build`. The app browses from this file alone and fetches a pack's manifest only when it is needed. Unknown properties are allowed (forward compatibility); a breaking change raises schemaVersion.",
  "type": "object",
  "required": ["schemaVersion", "generated", "games"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generated": { "description": "When the index was built (RFC 3339 with offset).", "$ref": "#/$defs/date" },
    "games": {
      "description": "Game ID (steam:<app id> or fp:<SHA-256 fingerprint>) → its packs and flags.",
      "type": "object",
      "propertyNames": { "pattern": "^(steam:[1-9][0-9]{0,9}|fp:[0-9a-f]{64})$" },
      "additionalProperties": { "$ref": "#/$defs/game" }
    },
    "dependencies": {
      "description": "The registry's dependency whitelist (policy/dependencies.json, schema dependency-whitelist.schema.json): executables packs may require, with their official release files and hashes, ordered by id.",
      "type": "array",
      "items": { "$ref": "#/$defs/dependency" }
    },
    "antiCheats": {
      "description": "Anti-cheat detection rules of the registry's policy/anti-cheat.json (schema anti-cheat.schema.json), in its order: the app puts them on top of its bundled list (same id = replaced, new ones added).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "markers"],
        "properties": {
          "id": { "$ref": "#/$defs/antiCheatId" },
          "name": { "type": "string", "pattern": "\\S" },
          "markers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^([^/\\\\*?]+/)*[^/\\\\]+/?$",
              "allOf": [
                { "pattern": "\\S" },
                { "not": { "pattern": "(^|/)\\.\\.?(/|$)" } }
              ]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "antiCheatId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "not": { "const": "none" }
    },
    "dependency": {
      "type": "object",
      "required": [
        "id",
        "name",
        "homepage",
        "versions"
      ],
      "properties": {
        "id": {
          "description": "What a manifest's dependencies[].id names; unique.",
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
          "maxLength": 64
        },
        "name": {
          "description": "Shown to the player.",
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "pattern": "\\S"
        },
        "homepage": {
          "description": "The project's official page.",
          "type": "string",
          "pattern": "^https://"
        },
        "layout": {
          "description": "Where the release archive goes: the content of `from` (a folder inside the archive; default its root) into `into` (a folder of the game; default the game folder).",
          "type": "object",
          "properties": {
            "from": {
              "$ref": "#/$defs/folder"
            },
            "into": {
              "$ref": "#/$defs/folder"
            }
          }
        },
        "generated": {
          "description": "Files and folders the component makes in the game folder when the game runs, deleted on uninstall when they weren't there before the install: a folder ends with '/' (removed when empty), '*' / '?' only in the last part of a file inside a folder.",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^([^/\\\\:*?]+/)*([^/\\\\:]+/?)$",
            "not": {
              "pattern": "(^|/)\\.\\.?(/|$)|^[^/]*[*?]|[*?][^/]*/$"
            }
          }
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "version",
              "assets"
            ],
            "properties": {
              "version": {
                "description": "What a manifest's dependencies[].version names; unique per dependency.",
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9.+\\-]{0,63}$"
              },
              "assets": {
                "description": "The official release file per platform of the game build (a Windows build under Proton takes the Windows file).",
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": [
                    "platform",
                    "url",
                    "size",
                    "sha256"
                  ],
                  "properties": {
                    "platform": {
                      "enum": [
                        "windows-x86",
                        "windows-x64",
                        "windows-arm64",
                        "linux-x86",
                        "linux-x64",
                        "linux-arm64",
                        "macos-x86",
                        "macos-x64",
                        "macos-arm64"
                      ]
                    },
                    "url": {
                      "description": "The official release file: a ZIP archive.",
                      "type": "string",
                      "pattern": "^https://"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "folder": {
      "type": "string",
      "pattern": "^([^/\\\\:]+/)*[^/\\\\:]+$",
      "not": {
        "pattern": "(^|/)\\.\\.?(/|$)"
      }
    },
    "game": {
      "type": "object",
      "properties": {
        "optOut": { "description": "The publisher asked not to distribute fan translations: install and generation are blocked.", "type": "boolean" },
        "antiCheatAllowed": { "description": "The game has an anti-cheat but officially allows mods: not blocked.", "type": "boolean" },
        "antiCheat": { "description": "The anti-cheat the registry's policy lists for the game by ID (one that leaves no files in the game folder): blocked unless antiCheatAllowed.", "$ref": "#/$defs/antiCheatId" },
        "packs": {
          "description": "Language tag → packs into that language.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/language" },
          "additionalProperties": { "type": "array", "items": { "$ref": "#/$defs/pack" } }
        },
        "requests": {
          "description": "Language tag → the open translation request into that language (requests collect, task 74); never for a language that has packs.",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/language" },
          "additionalProperties": { "$ref": "#/$defs/request" }
        }
      }
    },
    "request": {
      "description": "An open translation request: collected from its GitHub Discussion in the registry's Requests category.",
      "type": "object",
      "required": ["votes", "discussion", "opened"],
      "properties": {
        "votes": { "description": "Accounts that gave the request's Discussions a 👍 (bots left out).", "type": "integer", "minimum": 1 },
        "discussion": { "description": "The request's Discussion (the oldest open one).", "type": "string", "pattern": "^https://" },
        "opened": { "description": "When the Discussion was opened.", "$ref": "#/$defs/date" },
        "claim": {
          "description": "The translator working on it: their newest claim comment, edited at most 14 days ago.",
          "type": "object",
          "required": ["by", "state", "percent", "updated"],
          "properties": {
            "by": { "description": "The translator's GitHub login.", "type": "string", "maxLength": 39, "pattern": "^[A-Za-z0-9](-?[A-Za-z0-9]){0,38}$" },
            "state": { "enum": ["working", "built", "published"] },
            "stage": { "description": "The generation stage while working.", "enum": ["setup", "extract", "study", "glossary", "translate", "build", "done"] },
            "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
            "updated": { "description": "The claim comment's last edit: the last news.", "$ref": "#/$defs/date" }
          }
        }
      }
    },
    "pack": {
      "type": "object",
      "required": ["id", "title", "author", "status", "revision", "updated", "coverage", "buildIds", "buildCount", "manifest", "size"],
      "properties": {
        "id": { "description": "Pack ID, unique for the game + language.", "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
        "title": { "$ref": "#/$defs/text", "maxLength": 80 },
        "author": {
          "description": "The original author (the manifest's first author).",
          "type": "object",
          "required": ["github"],
          "properties": {
            "github": { "type": "string", "maxLength": 39, "pattern": "^[A-Za-z0-9](-?[A-Za-z0-9]){0,38}$" },
            "name": { "$ref": "#/$defs/text", "maxLength": 80 }
          }
        },
        "status": { "enum": ["alpha", "verified"] },
        "revision": { "type": "integer", "minimum": 1 },
        "updated": { "$ref": "#/$defs/date" },
        "coverage": {
          "type": "object",
          "required": ["translated", "total"],
          "properties": {
            "translated": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 1 }
          }
        },
        "buildIds": {
          "description": "Store build IDs the pack supports (empty for a manually added game, matched by file hashes).",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[0-9]{1,20}$" }
        },
        "buildCount": { "description": "How many game builds the manifest lists.", "type": "integer", "minimum": 1 },
        "manifest": {
          "description": "The pack's manifest.json, relative to index.json ('/' separators, no '.' or '..' parts).",
          "type": "string",
          "pattern": "^([^/\\\\]+/)*manifest\\.json$",
          "not": { "pattern": "(^|/)\\.\\.?(/|$)" }
        },
        "size": { "description": "Download size in bytes (string table or binary patch).", "type": "integer", "minimum": 1 },
        "rating": {
          "description": "Aggregated from the pack's GitHub Discussion; absent = nothing yet.",
          "type": "object",
          "properties": {
            "likes": { "type": "integer", "minimum": 0 },
            "works": { "description": "Players (not the author) who confirmed it works.", "type": "integer", "minimum": 0 },
            "doesNotWork": { "type": "integer", "minimum": 0 }
          }
        },
        "discussion": { "description": "The pack's GitHub Discussion.", "type": "string", "pattern": "^https://" }
      }
    },
    "language": {
      "enum": ["ar", "bg", "cs", "da", "de", "el", "en", "es-ES", "es-419", "fi", "fr", "hu", "id", "it", "ja", "ko", "nb", "nl", "pl", "pt-BR", "pt-PT", "ro", "ru", "sv", "th", "tr", "uk", "vi", "zh-Hans", "zh-Hant"]
    },
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "date": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$"
    }
  }
}
